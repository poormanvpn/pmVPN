{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "paths": {
      "@pmvpn/crypto-ssh/keyring": [
        "../crypto-ssh/src/keyring.ts"
      ],
      "@pmvpn/crypto-ssh/enrol": [
        "../crypto-ssh/src/enrol.ts"
      ]
    },
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src/**/*"
  ]
}
