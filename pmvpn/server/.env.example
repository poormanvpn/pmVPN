# pmVPN server configuration
#
# Copy to server/.env or ~/.pmvpn/.env, or point PMVPN_ENV_FILE at any file.
# Variables already in the environment (systemd, your shell) win over the file.
# A malformed connection setting stops the server at boot instead of being ignored.

# ── Network ──────────────────────────────────────────────────────────────────
# Base port. Services take base+0 to base+7; SSH speaks on +0, +1, +2 and +5.
PMVPN_BASE_PORT=2200
# Bind address. 0.0.0.0 accepts external connections; 127.0.0.1 is this machine only.
PMVPN_HOST=0.0.0.0
# Name written into generated ssh_config files, for a server behind NAT or a proxy.
# Unset: the Host header of the enrolment request.
# PMVPN_PUBLIC_HOST=vps.example.net

# ── Who may log in ───────────────────────────────────────────────────────────
# Wallet-to-user mapping (format: 0xaddress:username,0xaddress:username)
WALLET_USER_MAP=0xYourWalletAddress:yourusername
# true: any wallet that proves its signature gets its own jailed account.
# false: only wallets in WALLET_USER_MAP or ~/.pmvpn/wallets.json may log in.
# Set false on a server you do not mean to open to the public.
PMVPN_AUTO_REGISTER=true

# ── Multiple connections ─────────────────────────────────────────────────────
# Sockets one SSH port accepts at a time, counted before authentication.
PMVPN_MAX_CONNECTIONS_PER_PORT=256
# Authenticated connections one wallet may hold across all ports (SSH and WebSocket).
PMVPN_MAX_CONNECTIONS_PER_WALLET=32
# Channels on one SSH connection. Generated configs multiplex with ControlMaster;
# when this is reached, OpenSSH opens another connection instead.
PMVPN_MAX_SESSIONS_PER_CONNECTION=16
# Seconds an SSH client has to authenticate, counted from TCP accept.
PMVPN_LOGIN_GRACE_SECONDS=30
# Failed authentication attempts allowed on one SSH connection (key probes don't count).
PMVPN_MAX_AUTH_FAILURES=6
# Login challenges one client address may request per minute, across all ports.
PMVPN_CHALLENGES_PER_MINUTE=30
# Seconds between keepalive probes (0 = off), and unanswered probes before a drop.
PMVPN_KEEPALIVE_SECONDS=30
PMVPN_KEEPALIVE_COUNT_MAX=3

# ── Sessions: what Claude and other terminal tools see ───────────────────────
# PATH for shell, exec and browser sessions. A leading ~/ means the user's home.
# PMVPN_SESSION_PATH=~/.local/bin:/usr/local/bin:/usr/bin:/bin
# Variables a client may set with ssh SendEnv/SetEnv; a trailing * matches a prefix.
# PATH, HOME, LD_*, GIT_*, NODE_OPTIONS, PMVPN_* and similar are always refused.
# PMVPN_ACCEPT_ENV=LANG,LC_*,COLORTERM,ANTHROPIC_API_KEY
# Shell binary for PTY sessions
PMVPN_SHELL=/bin/bash
# Base directory for user home dirs
PMVPN_HOME_BASE=/home

# ── Keyring ──────────────────────────────────────────────────────────────────
# Number of port-scoped keys a wallet may enrol (default 8, max 64).
# Raise it so fleet or future services can claim indices 8+.
# PMVPN_KEYRING_SIZE=8

# ── Logging ──────────────────────────────────────────────────────────────────
# Log level (debug, info, warn, error)
LOG_LEVEL=info
# NODE_ENV=production

# ── Fleet (only read by pmvpn-server-entry.ts) ───────────────────────────────
# PMVPN_FLEET_BASE_PORT=2600
# PMVPN_FLEET_CONFIG=~/.pmvpn/fleet.json

# ── Other ────────────────────────────────────────────────────────────────────
# P2P file shares directory (default ~/.pmvpn/shares, mode 0700). Keep it out of /tmp.
# PMVPN_SHARES_DIR=~/.pmvpn/shares
# Hostinger cloud provider module (pmvpn-server-entry.ts)
# HOSTINGER_API_KEY=
# Exact hostinger-api-mcp version npx runs. Pinned so an upgrade is deliberate.
# PMVPN_HOSTINGER_MCP_VERSION=3.1.0
